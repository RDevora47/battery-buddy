<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BatteryBuddy</AssemblyName>
    <!-- Generated from the skin by tools/MakeIcon; rerun it after changing the pet's art. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its names out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Skins\axolotl\sprites.txt" LogicalName="skins.axolotl.sprites.txt" />
    <EmbeddedResource Include="Skins\axolotl\skin.json" LogicalName="skins.axolotl.skin.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Frontend + contract; the backend projects are referenced only by Backends.cs, the composition root. -->
    <ProjectReference Include="..\BatteryBuddy.Devices\BatteryBuddy.Devices.csproj" />
    <ProjectReference Include="..\BatteryBuddy.Pet\BatteryBuddy.Pet.csproj" />
    <ProjectReference Include="..\BatteryBuddy.Backend\BatteryBuddy.Backend.csproj" />
    <ProjectReference Include="..\BatteryBuddy.Backends.Windows\BatteryBuddy.Backends.Windows.csproj" />
    <ProjectReference Include="..\BatteryBuddy.Backends.GalaxyBuds\BatteryBuddy.Backends.GalaxyBuds.csproj" />
    <ProjectReference Include="..\BatteryBuddy.Backends.Logitech\BatteryBuddy.Backends.Logitech.csproj" />
  </ItemGroup>
</Project>
