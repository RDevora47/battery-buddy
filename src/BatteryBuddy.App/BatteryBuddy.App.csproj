<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>BatteryBuddy</AssemblyName>
    <!-- Generated from the skin by tools/MakeIcon; rerun it after changing the pet's art. -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- build.ps1 sets DiagLog=true unless -SelfContained: a rolling 5-minute logs\diag.log (see DiagLog.cs). -->
    <DefineConstants Condition="'$(DiagLog)' == 'true'">$(DefineConstants);DIAG_LOG</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its names out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <!-- skins.<pet>.<file>; "common" holds the sprites every pet shares. -->
    <EmbeddedResource Include="Skins\common\sprites.txt" LogicalName="skins.common.sprites.txt" />
    <EmbeddedResource Include="Skins\axolotl\sprites.txt" LogicalName="skins.axolotl.sprites.txt" />
    <EmbeddedResource Include="Skins\axolotl\skin.json" LogicalName="skins.axolotl.skin.json" />
    <EmbeddedResource Include="Skins\choppa\sprites.txt" LogicalName="skins.choppa.sprites.txt" />
    <EmbeddedResource Include="Skins\choppa\skin.json" LogicalName="skins.choppa.skin.json" />
    <EmbeddedResource Include="Skins\missy\sprites.txt" LogicalName="skins.missy.sprites.txt" />
    <EmbeddedResource Include="Skins\missy\skin.json" LogicalName="skins.missy.skin.json" />
    <EmbeddedResource Include="Skins\ragdoll\sprites.txt" LogicalName="skins.ragdoll.sprites.txt" />
    <EmbeddedResource Include="Skins\ragdoll\skin.json" LogicalName="skins.ragdoll.skin.json" />
    <EmbeddedResource Include="Skins\duck\sprites.txt" LogicalName="skins.duck.sprites.txt" />
    <EmbeddedResource Include="Skins\duck\skin.json" LogicalName="skins.duck.skin.json" />
    <EmbeddedResource Include="Skins\pig\sprites.txt" LogicalName="skins.pig.sprites.txt" />
    <EmbeddedResource Include="Skins\pig\skin.json" LogicalName="skins.pig.skin.json" />
    <EmbeddedResource Include="Skins\capybara\sprites.txt" LogicalName="skins.capybara.sprites.txt" />
    <EmbeddedResource Include="Skins\capybara\skin.json" LogicalName="skins.capybara.skin.json" />
    <EmbeddedResource Include="Skins\redpanda\sprites.txt" LogicalName="skins.redpanda.sprites.txt" />
    <EmbeddedResource Include="Skins\redpanda\skin.json" LogicalName="skins.redpanda.skin.json" />
    <EmbeddedResource Include="Skins\bunny\sprites.txt" LogicalName="skins.bunny.sprites.txt" />
    <EmbeddedResource Include="Skins\bunny\skin.json" LogicalName="skins.bunny.skin.json" />
    <EmbeddedResource Include="Skins\panda\sprites.txt" LogicalName="skins.panda.sprites.txt" />
    <EmbeddedResource Include="Skins\panda\skin.json" LogicalName="skins.panda.skin.json" />
    <EmbeddedResource Include="Skins\parrot\sprites.txt" LogicalName="skins.parrot.sprites.txt" />
    <EmbeddedResource Include="Skins\parrot\skin.json" LogicalName="skins.parrot.skin.json" />
    <EmbeddedResource Include="Skins\jellyfish\sprites.txt" LogicalName="skins.jellyfish.sprites.txt" />
    <EmbeddedResource Include="Skins\jellyfish\skin.json" LogicalName="skins.jellyfish.skin.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Frontend + contract; the backend projects are referenced only by Backends.cs, the composition root. -->
    <ProjectReference Include="..\BatteryBuddy.Devices\BatteryBuddy.Devices.csproj" />
    <ProjectReference Include="..\BatteryBuddy.Pet\BatteryBuddy.Pet.csproj" />
    <ProjectReference Include="..\BatteryBuddy.Backend\BatteryBuddy.Backend.csproj" />
    <ProjectReference Include="..\BatteryBuddy.Backends.Windows\BatteryBuddy.Backends.Windows.csproj" />
    <ProjectReference Include="..\BatteryBuddy.Backends.GalaxyBuds\BatteryBuddy.Backends.GalaxyBuds.csproj" />
    <ProjectReference Include="..\BatteryBuddy.Backends.Logitech\BatteryBuddy.Backends.Logitech.csproj" />
  </ItemGroup>
</Project>
