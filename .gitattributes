# Line endings: LF in the repository, native (CRLF on Windows) in the working tree.
* text=auto

*.cs       text diff=csharp
*.xaml     text
*.csproj   text
*.props    text
*.targets  text
*.json     text
*.md       text diff=markdown
*.txt      text

# Windows-only files keep CRLF on checkout on every platform.
*.sln      text eol=crlf
*.ps1      text eol=crlf
*.cmd      text eol=crlf
*.bat      text eol=crlf

*.png      binary
*.jpg      binary
*.gif      binary
*.ico      binary
*.dll      binary
*.exe      binary
